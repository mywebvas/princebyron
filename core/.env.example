# =============================================================================
# Prince Byron — Application Environment Configuration Example
# =============================================================================
# Copy to .env and fill in real values for your environment.
# NEVER commit .env to version control.
# Keep secrets out of chat, source control, and prototype files.
# =============================================================================

APP_NAME="Prince Byron"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/New_York
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging — do NOT log passwords, tokens, payment payloads, bank details, PII.
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — PostgreSQL (isolated Docker container on port 5437 for local dev)
# See docker-compose.yml for the princebyron_postgres container definition.
# DB_PASSWORD must be set in .env — never committed.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5437
DB_DATABASE=princebyron
DB_USERNAME=princebyron
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session / Cache / Queue
# Redis runs on port 6383 (princebyron_redis container).
# Change SESSION_SECURE_COOKIE to true in production (requires HTTPS).
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6383

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail — Mailpit for local dev (SMTP 1025, Web UI http://localhost:8025)
# Never send real email from development.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@princebyron.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Private file storage (protected audio, order documents)
# Keep private audio outside public web root; use short-lived signed URLs.
# Configure S3-compatible storage before production launch.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Payment providers — SANDBOX/TEST ONLY during development
# Never commit real API keys. Leave blank until separately configured and
# explicitly approved by the owner for production use.
# -----------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# -----------------------------------------------------------------------------
# Vite / Frontend
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
