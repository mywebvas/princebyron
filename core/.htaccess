# =============================================================================
# Prince Byron — Application Root Denial (defense in depth)
# =============================================================================
# The root .htaccess and root index.php already deny /core/*, but those are a
# single layer: if a host ignores mod_rewrite, ships an unexpected httpd
# configuration, or the root rules are ever edited, every application file
# below this directory (including .env and the prebuilt vendor/) becomes
# directly downloadable.
#
# This file makes the denial travel WITH the application directory, so the
# protection still holds when core/ is the only thing an operator uploads, or
# when the document root is misconfigured to public_html instead of
# public_html/core/public.
#
# Two supported deployment shapes must both keep working:
#   A. domain document root = public_html/          (root loader + .htaccess)
#   B. domain document root = public_html/core/public/  (preferred, if offered)
# In shape B this file is outside the document root and is simply inert.
# =============================================================================

# Deny everything by default, then re-open Laravel's public front controller.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Nothing is served from here: requests must enter through core/public/.
