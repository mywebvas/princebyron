# =============================================================================
# Prince Byron — Runtime Storage Denial (defense in depth)
# =============================================================================
# storage/ holds the things that must never be public:
#   app/private/audio/     purchased masters (entitlement-gated only)
#   app/private/*          order documents
#   logs/                  application logs, possibly containing customer data
#   framework/sessions/    session files (session hijack if downloadable)
#   framework/cache/       cached pricing/config fragments
#   framework/views/       compiled templates (source disclosure)
#
# Deny all direct HTTP access. Download services stream files through a
# controller after an entitlement check; they never rely on a public URL.
# =============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [F,L]
</IfModule>
