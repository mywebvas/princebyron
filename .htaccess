# =============================================================================
# Prince Byron Official Platform — Root .htaccess for cPanel Deployment
# =============================================================================
# Enforces strict directory and file denial for core/, .env, vendor/, and private
# storage, preserves authorization headers, and routes requests to index.php.
# =============================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # -------------------------------------------------------------------------
    # Hard Block Private Directories & Files (Defense-in-Depth)
    # -------------------------------------------------------------------------
    RewriteRule ^core(/|$) - [F,L]
    RewriteRule ^vendor(/|$) - [F,L]
    RewriteRule ^storage(/|$) - [F,L]
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^\.git.*$ - [F,L]

    # Block sensitive file extensions
    <FilesMatch "(^\.env|\.git|\.lock$|\.json$|\.sql$|\.log$|\.md$|composer\.)">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # -------------------------------------------------------------------------
    # Route Public Assets Directly to core/public/
    # -------------------------------------------------------------------------
    RewriteCond %{REQUEST_URI} ^/build/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/core/public/build/%1 -f
    RewriteRule ^build/(.*)$ core/public/build/$1 [L]

    RewriteCond %{REQUEST_URI} ^/assets/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/core/public/assets/%1 -f
    RewriteRule ^assets/(.*)$ core/public/assets/$1 [L]

    # Images and audio are served from core/public because the document root is
    # the repository root (cPanel upload), not core/public. Without these rules
    # every <img> and the free-track download returned 404 — the site rendered
    # without a single photograph (review P0-4).
    #
    # The -f check is deliberate: a missing file falls through to the front
    # controller and returns a normal 404 rather than being rewritten blindly.
    RewriteCond %{REQUEST_URI} ^/images/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/core/public/images/%1 -f
    RewriteRule ^images/(.*)$ core/public/images/$1 [L]

    RewriteCond %{REQUEST_URI} ^/audio/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/core/public/audio/%1 -f
    RewriteRule ^audio/(.*)$ core/public/audio/$1 [L]

    # Filament admin assets. `php artisan filament:assets` publishes these into
    # core/public/{css,js,fonts}/filament at build time. They are a build
    # product (not committed), but without these routes the admin panel at
    # /admin loads completely unstyled on the host even when the file was
    # correctly built (review P0-5). The -f guard keeps missing assets a clean
    # 404 rather than a blind rewrite.
    RewriteCond %{REQUEST_URI} ^/css/filament/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/core/public/css/filament/%1 -f
    RewriteRule ^css/filament/(.*)$ core/public/css/filament/$1 [L]

    RewriteCond %{REQUEST_URI} ^/js/filament/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/core/public/js/filament/%1 -f
    RewriteRule ^js/filament/(.*)$ core/public/js/filament/$1 [L]

    RewriteCond %{REQUEST_URI} ^/fonts/filament/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/core/public/fonts/filament/%1 -f
    RewriteRule ^fonts/filament/(.*)$ core/public/fonts/filament/$1 [L]

    # Site icon. public/favicon.ico was a committed 0-byte file; the real icon
    # lives in core/public so this route must exist for it to be reachable.
    RewriteCond %{DOCUMENT_ROOT}/core/public/favicon.ico -f
    RewriteRule ^favicon\.ico$ core/public/favicon.ico [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Allow direct access to existing files/folders in public root (e.g. install/)
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Send All Other Requests To Front Controller
    RewriteRule ^ index.php [L]
</IfModule>

# -----------------------------------------------------------------------------
# GZIP / Deflate Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff
</IfModule>

# -----------------------------------------------------------------------------
# Browser Caching via mod_expires
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------------------
# Security Headers & Cache-Control
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Baseline Security Headers (ASVS 5.0 L2)
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
